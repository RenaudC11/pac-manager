#!/usr/bin/with-contenv sh
API_KEY=$(python3 -c "import json; d=json.load(open('/data/options.json')); print(d.get('anthropic_api_key',''))" 2>/dev/null || echo "")
sed -i "s|__ANTHROPIC_API_KEY__|${API_KEY}|g" /var/www/html/index.html
echo "[PAC Manager] v1.4.0 démarré — clé API: ${#API_KEY} caractères"
exec nginx -g "daemon off;"
