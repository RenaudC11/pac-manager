#!/usr/bin/with-contenv sh

# Injecter la clé API
GEMINI_KEY=$(python3 -c "import json; d=json.load(open('/data/options.json')); print(d.get('gemini_api_key',''))" 2>/dev/null || echo "")
sed -i "s|__GEMINI_API_KEY__|${GEMINI_KEY}|g" /var/www/html/index.html
echo "[PAC Manager] v1.9.4 démarré — clé Gemini: ${#GEMINI_KEY} car."

# Démarrer le serveur de config persistante en arrière-plan
python3 /var/www/html/config_server.py &
PYTHON_PID=$!

# Attendre que Python soit prêt (max 5 secondes)
for i in $(seq 1 10); do
  if wget -q -O /dev/null http://127.0.0.1:8098/pac-config 2>/dev/null; then
    echo "[PAC Manager] config_server prêt (${i}x0.5s)"
    break
  fi
  sleep 0.5
done

# Démarrer nginx
exec nginx -g "daemon off;"
